# Paths to the implementation repos under evaluation. Sourced by
# orchestrator/run_grid.sh.
#
# Both are vendored as git submodules under libs/, pinned to the exact commits
# the committed results were measured against. Clone with:
#
#     git clone --recurse-submodules <this repo>
#
# or, in an existing clone:
#
#     git submodule update --init --recursive
#
# (--recursive matters: Three-Round-Multiparty-ECDSA carries BICYCL as a
# submodule of its own.)
#
# If the submodules are not checked out, these fall back to siblings of this
# repo, the layout the harness originally used. Either can also be overridden
# by exporting it before invoking the orchestrator, e.g.
#     TSSLIB_REPO=~/src/tss-lib orchestrator/run_grid.sh
# rather than by editing this file, so a local checkout layout never has to be
# committed.

_HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_WORKSPACE="$(dirname "$_HARNESS_ROOT")"

_pick_repo() {  # _pick_repo <submodule path> <sibling path>
    if [ -e "$1/CMakeLists.txt" ] || [ -e "$1/go.mod" ]; then
        printf '%s' "$1"
    else
        printf '%s' "$2"
    fi
}

TRECDSA_REPO="${TRECDSA_REPO:-$(_pick_repo "$_HARNESS_ROOT/libs/Three-Round-Multiparty-ECDSA" "$_WORKSPACE/Three-Round-Multiparty-ECDSA")}"
TSSLIB_REPO="${TSSLIB_REPO:-$(_pick_repo "$_HARNESS_ROOT/libs/tss-lib" "$_WORKSPACE/tss-lib")}"

# Build artifacts for both adapters are kept OUTSIDE any cloud-synced tree.
# Lesson learned: a stale cloud-synced CMake build/ directory became an
# unreadable cloud-only placeholder (ETIMEDOUT) after not being touched for a
# while. Source, schema, scripts, and JSON results are small text and sync
# fine; only compiled/cached artifacts get redirected here.
#
# This also turned out to be what saved the eval binaries when the synced tree
# was damaged — see HARNESS_REPORT.md, "Reconstruction status".
TECDSA_BUILD_DIR="${TECDSA_BUILD_DIR:-$HOME/.tss-eval-build}"
