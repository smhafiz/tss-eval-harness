# Paths to the implementation repos under evaluation. Sourced by
# orchestrator/run_grid.sh.
#
# Both default to siblings of this harness, which is the layout the harness
# assumes:
#
#     <workspace>/Three-Round-Multiparty-ECDSA
#     <workspace>/tss-lib
#     <workspace>/tss-eval-harness      <- this repo
#
# Override either by exporting it before invoking the orchestrator, e.g.
#     TSSLIB_REPO=~/src/tss-lib orchestrator/run_grid.sh
# rather than by editing this file, so a local checkout layout never has to be
# committed.

_HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_WORKSPACE="$(dirname "$_HARNESS_ROOT")"

TRECDSA_REPO="${TRECDSA_REPO:-$_WORKSPACE/Three-Round-Multiparty-ECDSA}"
TSSLIB_REPO="${TSSLIB_REPO:-$_WORKSPACE/tss-lib}"

# Build artifacts for both adapters are kept OUTSIDE any cloud-synced tree.
# Lesson learned: a stale cloud-synced CMake build/ directory became an
# unreadable cloud-only placeholder (ETIMEDOUT) after not being touched for a
# while. Source, schema, scripts, and JSON results are small text and sync
# fine; only compiled/cached artifacts get redirected here.
#
# This also turned out to be what saved the eval binaries when the synced tree
# was damaged — see HARNESS_REPORT.md, "Reconstruction status".
TECDSA_BUILD_DIR="${TECDSA_BUILD_DIR:-$HOME/.tss-eval-build}"
